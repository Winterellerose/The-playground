{
  "name": "the-playground",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "description": "Multi-provider AI studio — single-file artifact built from modular source",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "python3 -m http.server 8000",
    "test": "node tests/run.cjs",
    "audit:models": "node tests/audit-models.cjs",
    "verify:vendor": "node scripts/verify-vendor.js",
    "lint": "eslint . --ext .js,.mjs,.cjs",
    "format": "prettier --write .",
    "relay:nim": "node nim-cors-proxy.js",
    "relay:nim:port": "node nim-cors-proxy.js --port",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "dompurify": "3.4.18",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "highlight.js": "11.11.1",
    "marked": "15.0.7",
    "prettier": "^3.10.1",
    "tar": "^7.5.23"
  }
}
